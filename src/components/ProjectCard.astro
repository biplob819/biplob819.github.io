---
import { KIND_LABEL, STATUS_LABEL, type Project } from '../lib/projects';
interface Props { project: Project; }
const { project } = Astro.props;
const d = project.data;
const st = d.story ?? {};
const counts = [
  st.evals?.length && `${st.evals.length} eval${st.evals.length > 1 ? 's' : ''}`,
  st.improvements?.length && `${st.improvements.length} measured improvement${st.improvements.length > 1 ? 's' : ''}`,
  st.learnings?.length && `${st.learnings.length} lesson${st.learnings.length > 1 ? 's' : ''}`,
].filter(Boolean);
---
<a class="card" href={`/projects/${project.id}/`}>
  <div class="head">
    <span class="label">{KIND_LABEL[d.kind]}</span>
    <span class="right">{d.license && <span class="oss">Open source · {d.license}</span>}<span class:list={['status', d.status]}>{STATUS_LABEL[d.status]}</span></span>
  </div>
  {d.headline ? (
    <div class="metric">
      <span class="num big"><span class="hl">{d.headline.value}</span></span>
      <span class="ml">{d.headline.label}</span>
    </div>
  ) : (
    <div class="metric pending">
      <span class="num big ghost">—</span>
      <span class="ml">Result published with the evaluation run</span>
    </div>
  )}
  <h3>{d.title}</h3>
  <p>{d.tagline}</p>
  {d.stack.length > 0 && <div class="stack">{d.stack.slice(0, 3).map((s) => <span>{s}</span>)}</div>}
  {counts.length > 0 && <p class="counts">{counts.join(' · ')}</p>}
  <span class="read">Read the case <span aria-hidden="true">→</span></span>
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 12px; padding: 22px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg); text-decoration: none; transition: transform .15s, border-color .15s; min-width: 0; }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .right { display: inline-flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .oss { font: 500 11px/1 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--good); border: 1px solid currentColor; border-radius: 999px; padding: 3px 7px; }
  .metric { display: flex; flex-direction: column; gap: 6px; padding-top: 6px; }
  .big { font-size: clamp(42px, 5vw, 56px); }
  .ghost { color: var(--line); }
  .ml { font: 400 12px/1.45 var(--f-mono); color: var(--muted); max-width: 46ch; }
  h3 { margin: 6px 0 0; font: 600 18px/1.3 var(--f-body); letter-spacing: -.01em; }
  p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .counts { font: 500 11.5px/1.4 var(--f-mono); color: var(--ink-2); text-transform: uppercase; letter-spacing: .04em; }
  .read { margin-top: auto; padding-top: 6px; font-size: 14px; font-weight: 500; color: var(--accent); }
  .card:hover .read span { display: inline-block; transform: translateX(3px); transition: transform .15s; }
</style>
