---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site, atWork, sport, education, now, teaching } from '../site.config';
import { projects, STATUS_LABEL } from '../lib/projects';

const platforms = await projects('product');
const oss = await projects('open-source');
const builds = await projects('case-study');
const published = builds.filter((p) => p.data.headline).length;
const INSTALL: Record<string, string> = {
  evalkit: "pip install 'evalkit-harness[anthropic,openai]'",
  'build-harness': '/plugin marketplace add biplob819/build-harness',
};
---
<Base image="/images/kova.jpg">
  <section class="hero wrap">
    <div class="chips">
      {site.roles.map((r, i) => <span class:list={['chip', { strong: i === site.roles.length - 1 }]}>{r}</span>)}
    </div>
    <p class="status-line"><span class="dot" aria-hidden="true"></span>Shipping Kova · building Insightsflow · training for the 2027 Asian Championships</p>
    <h1 class="cond">I lead AI products <span class="muted-h">and race modern pentathlon for India.</span></h1>
    <p class="lead">
      I'm Lead PM, Data and AI/ML (Agentic Analytics) at <strong>Mindbody</strong>. I shipped its first agentic product and led ML products that contributed to <strong>$103M+ in incremental ARR</strong>.
      I'm also building <a class="tlink" href="https://kovahr.com/" rel="noopener">Kova</a> and <a class="tlink" href="https://insightsflow.live/" rel="noopener">Insightsflow</a> end to end, and I'm a PhD scholar in AI at IIT Kharagpur.
    </p>
    <div class="cta">
      <a class="btn primary" href={site.links.cv} rel="noopener"><Icon name="download" />Download CV</a>
      <a class="btn" href={site.links.linkedin} rel="me noopener"><Icon name="linkedin" />LinkedIn</a>
      <a class="btn" href={site.links.github} rel="me noopener"><Icon name="github" />GitHub</a>
      <button type="button" class="btn" data-feedback data-title="Get in touch" data-subject="Hiring: from the portfolio home page">Get in touch</button>
    </div>
    <dl class="board" aria-label="Results">
      {site.ledger.map((l) => (
        <div><dt class="num">{l.value}</dt><dd class="label">{l.label}</dd></div>
      ))}
    </dl>
  </section>

  <section class="block wrap" id="work">
    <div class="sec-head"><h2 class="cond">At work</h2><span class="label">{atWork.company} · {atWork.period}</span></div>
    <p class="intro">{atWork.title}. Products I built there, with the number each one moved.</p>
    <div class="results" role="table" aria-label="Products built at Mindbody">
      {atWork.items.map((it) => (
        <div class="rrow" role="row">
          <span class="num rv" role="cell">{it.metric}</span>
          <div role="cell"><h3>{it.name}</h3><p>{it.text}</p></div>
          <span class="label rl" role="cell">{it.metricLabel}</span>
        </div>
      ))}
    </div>
    <ol class="timeline">
      {atWork.earlier.map((e) => <li><span class="label">{e.period}</span><span><strong>{e.company}</strong> · {e.title}{e.note && <span class="muted"> · {e.note}</span>}</span></li>)}
      {education.map((e) => <li><span class="label">{e.period}</span><span><strong>{e.place}</strong> · {e.name}</span></li>)}
    </ol>
  </section>

  <section class="block wrap" id="platforms">
    <div class="sec-head"><h2 class="cond">Platforms I'm building</h2><span class="label">End to end · {platforms.length}</span></div>
    <div class="rows">
      {platforms.map((p, i) => (
        <article class:list={['prow', { flip: i % 2 === 1 }]}>
          {p.data.cover && (
            <a class="shot" href={`/projects/${p.id}/`} aria-label={`${p.data.title} case study`}>
              <img src={p.data.cover} alt={`${p.data.title} product screen`} loading={i === 0 ? 'eager' : 'lazy'} width="1440" height="900" />
            </a>
          )}
          <div class="ptext">
            <span class:list={['status', p.data.status]}>{STATUS_LABEL[p.data.status]}</span>
            <h3 class="cond">{p.data.title}</h3>
            <p>{p.data.tagline}</p>
            {p.data.headline && (
              <p class="pmetric"><span class="num"><span class="hl">{p.data.headline.value}</span></span><span class="label">{p.data.headline.label}</span></p>
            )}
            <div class="plinks">
              {p.data.links.site && <a class="tlink" href={p.data.links.site} rel="noopener">{new URL(p.data.links.site).host} ↗</a>}
              <a class="tlink" href={`/projects/${p.id}/`}>Case study →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="block wrap" id="builds">
    <div class="sec-head"><h2 class="cond">AI builds, scored</h2><span class="label">{published} of {builds.length} results published</span></div>
    <p class="intro">Each build starts from a real team's problem, ships as a public repo, and is measured with EvalKit: quality, cost per answer and confidence intervals. The rest are being built in public and publish their numbers when the evaluation run lands.</p>
    <div class="cards">{builds.map((p) => <ProjectCard project={p} />)}</div>
    <p class="more"><a class="tlink" href="/projects/">All builds →</a></p>
  </section>

  <section class="block wrap" id="open-source">
    <div class="sec-head"><h2 class="cond">Open source</h2><span class="label">The tools underneath</span></div>
    <div class="oss">
      {oss.map((p) => (
        <a class="orow" href={`/projects/${p.id}/`}>
          <div class="otitle"><h3>{p.data.title}</h3><span class:list={['status', p.data.status]}>{STATUS_LABEL[p.data.status]}</span></div>
          <p>{p.data.tagline}</p>
          {INSTALL[p.id] ? <code class="install">{INSTALL[p.id]}</code> : <span class="label">{p.data.metrics[0] ? `${p.data.metrics[0].value} ${p.data.metrics[0].label}` : ''}</span>}
        </a>
      ))}
    </div>
  </section>


  <section class="block wrap" id="teaching">
    <div class="sec-head"><h2 class="cond">Teaching</h2><span class="label">IIT Kharagpur · upGrad</span></div>
    <div class="teach">
      <div class="ttext">
        <p class="label">{teaching.program}</p>
        <h3 class="cond">{teaching.course}</h3>
        <p class="trole">{teaching.role}</p>
        <p class="pmetric"><span class="num"><span class="hl">{teaching.students}</span></span><span class="label">{teaching.studentsLabel}</span></p>
        <ul class="tfacts">{teaching.facts.map((f) => <li>{f}</li>)}</ul>
        <a class="tlink" href={teaching.url} rel="noopener">Course page ↗</a>
      </div>
      <div class="tshots">
        {teaching.images.map((im) => (
          <a href={teaching.url} rel="noopener" class="tshot"><img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" /></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sport" id="sport">
    <div class="wrap sgrid">
      <div>
        <span class="bib">IND</span>
        <h2 class="cond">{sport.headline}</h2>
        <ul class="facts">{sport.facts.map((f) => <li>{f}</li>)}</ul>
        <p class="why">{sport.link}</p>
      </div>
      <ol class="events" aria-label="The five disciplines">
        {sport.events.map((e, i) => <li><span class="label">{String(i + 1).padStart(2, '0')}</span><span class="cond">{e}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="block wrap" id="now">
    <div class="sec-head"><h2 class="cond">Now</h2><span class="label">This month</span></div>
    <ul class="now">{now.map((n) => <li>{n}</li>)}</ul>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(40px, 7vw, 88px) 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .status-line { display: flex; align-items: center; gap: 10px; margin: 18px 0 0; font: 400 13px/1.4 var(--f-mono); color: var(--muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 4px color-mix(in srgb, var(--good) 22%, transparent); flex: none; }
  .muted-h { color: var(--muted); }
  h1 { font-size: clamp(42px, 6.6vw, 92px); margin: 16px 0 0; max-width: 22ch; }
  .lead { font-size: clamp(16.5px, 1.6vw, 19px); color: var(--muted); max-width: 62ch; margin: 24px 0 0; }
  .lead strong { color: var(--ink); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(40px, 6vw, 64px) 0 0; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--line); }
  .board div { padding: 16px 16px 18px 0; border-right: 1px solid var(--line); min-width: 0; }
  .board div + div { padding-left: 16px; }
  .board div:last-child { border-right: 0; }
  .board dt { font-size: clamp(40px, 6vw, 72px); }
  .board dd { margin: 8px 0 0; max-width: 26ch; }
  @media (max-width: 760px) {
    .board { grid-template-columns: 1fr 1fr; }
    .board div { border-right: 0; border-bottom: 1px solid var(--line); padding: 14px 12px 14px 0 !important; }
    .board div:nth-child(even) { padding-left: 12px !important; border-left: 1px solid var(--line); }
    .board div:nth-last-child(-n+2) { border-bottom: 0; }
  }

  .teach { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .ttext { display: flex; flex-direction: column; gap: 12px; }
  .ttext > .label { margin: 0; }
  .ttext h3 { font-size: clamp(32px, 4vw, 48px); margin: 0; line-height: .95; }
  .trole { margin: 0; font-weight: 500; font-size: 17px; }
  .tfacts { margin: 4px 0 6px; padding-left: 18px; color: var(--ink-2); display: grid; gap: 6px; font-size: 15.5px; }
  .tshots { display: grid; gap: 14px; }
  .tshot img { width: 100%; height: auto; border-radius: var(--r); border: 1px solid var(--line); display: block; }
  .tshot:nth-child(2) { width: 62%; justify-self: end; margin-top: -48px; box-shadow: 0 12px 32px rgb(13 17 23 / .14); border-radius: var(--r); background: #fff; }
  @media (max-width: 860px) { .teach { grid-template-columns: 1fr; } .tshot:nth-child(2) { width: 80%; margin-top: -32px; } }
  .rows { display: grid; gap: clamp(40px, 6vw, 72px); }
  .prow { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .prow.flip .shot { order: 2; }
  .shot { display: block; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line); background: var(--surface); transition: transform .2s, border-color .2s; }
  .shot:hover { transform: translateY(-3px); border-color: var(--accent); }
  .shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .ptext { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .ptext h3 { font-size: clamp(44px, 6vw, 72px); margin: 0; }
  .ptext p { margin: 0; color: var(--muted); font-size: 16.5px; }
  .pmetric { display: flex; flex-direction: column; gap: 6px; padding-top: 8px; border-top: 1px solid var(--line); }
  .pmetric .num { font-size: 44px; color: var(--ink); }
  .plinks { display: flex; gap: 18px; flex-wrap: wrap; font-size: 15px; }
  @media (max-width: 820px) { .prow { grid-template-columns: 1fr; } .prow.flip .shot { order: 0; } }

  .intro { color: var(--muted); max-width: 70ch; margin: -8px 0 28px; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
  .more { margin: 22px 0 0; }

  .oss { display: grid; border-top: 1px solid var(--line); }
  .orow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .orow:hover h3 { color: var(--accent); }
  .otitle { display: flex; flex-direction: column; gap: 8px; }
  .orow h3 { margin: 0; font: 600 20px var(--f-body); }
  .orow p { margin: 0; color: var(--muted); font-size: 15px; }
  .install { font: 400 12.5px/1.5 var(--f-mono); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; overflow-x: auto; white-space: nowrap; }
  @media (max-width: 820px) { .orow { grid-template-columns: 1fr; gap: 10px; } }

  .results { border-top: 3px solid var(--ink); }
  .rrow { display: grid; grid-template-columns: 170px minmax(0, 1.6fr) minmax(0, 1fr); gap: 20px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .rv { font-size: clamp(36px, 4.4vw, 48px); }
  .rrow h3 { margin: 0; font: 600 17.5px var(--f-body); }
  .rrow p { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .rl { text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  @media (max-width: 760px) { .rrow { grid-template-columns: 1fr; gap: 6px; } }
  .timeline { list-style: none; margin: 36px 0 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 170px 1fr; gap: 20px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  @media (max-width: 560px) { .timeline li { grid-template-columns: 1fr; gap: 2px; } }

  .sport { background: var(--band); color: var(--on-band); margin-top: clamp(64px, 9vw, 112px); padding-block: clamp(48px, 8vw, 96px); }
  .sgrid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .bib { font: 500 11px/1 var(--f-mono); background: var(--lime); color: var(--on-lime); padding: 5px 8px; border-radius: 4px; letter-spacing: .06em; }
  .sport h2 { font-size: clamp(44px, 7vw, 88px); margin: 18px 0 0; }
  .facts { list-style: none; padding: 0; margin: 24px 0 0; }
  .facts li { padding: 10px 0; border-bottom: 1px solid color-mix(in srgb, var(--on-band) 18%, transparent); font-size: 17px; }
  .why { margin: 22px 0 0; max-width: 54ch; color: color-mix(in srgb, var(--on-band) 72%, transparent); }
  .events { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--lime); }
  .events li { display: flex; align-items: baseline; gap: 18px; padding: 14px 0; border-bottom: 1px solid color-mix(in srgb, var(--on-band) 18%, transparent); }
  .events .label { color: var(--lime); }
  .events .cond { font-size: clamp(32px, 4.4vw, 52px); }
  @media (max-width: 820px) { .sgrid { grid-template-columns: 1fr; } }

  .now { list-style: none; padding: 0; margin: 0; max-width: 72ch; }
  .now li { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
  .now li::before { content: '→'; color: var(--accent); }
</style>
