---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { projects, KIND_LABEL, STATUS_LABEL, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await projects();
  return all.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const d = project.data;
const { Content, headings } = await render(project);
const results = d.images.filter((im) => im.kind === 'result');
const diagrams = d.images.filter((im) => im.kind === 'architecture' || im.kind === 'dataflow');
const shots = d.images.filter((im) => im.kind === 'screenshot');
const LINK_LABEL: Record<string, string> = { site: 'Website', demo: 'Live demo', repo: 'Code', report: 'Results report', package: 'Package', video: '90-second video', prd: 'PRD', techspec: 'Tech spec', architecture: 'Architecture', dataflow: 'Data flow', methodology: 'Methodology' };
const LINK_ORDER = ['demo', 'site', 'repo', 'video', 'report', 'prd', 'techspec', 'architecture', 'dataflow', 'methodology', 'package'];
const links = LINK_ORDER.filter((k) => (d.links as Record<string, string | undefined>)[k]).map((k) => [k, (d.links as Record<string, string>)[k]]) as [string, string][];
const st = d.story ?? {};
const CALL_LABEL = { built: 'Built', cut: 'Cut', later: 'Later' } as const;
const KIND_TAG = { 'north-star': 'North star', adoption: 'Adoption', quality: 'Quality', guardrail: 'Guardrail', cost: 'Cost' } as const;
const designLinks = (['architecture', 'dataflow'] as const).filter((k) => d.links[k]);
// Story sections come first on the page, then the hand-written deep dive.
const storyToc = [
  st.pain && { slug: 'pain', text: 'The pain' },
  (st.bet || st.priorities?.length) && { slug: 'priorities', text: 'The bet and the cuts' },
  (diagrams.length || designLinks.length) && { slug: 'how-it-works', text: 'How it works' },
].filter(Boolean) as { slug: string; text: string }[];
const showTarget = st.monitoring?.some((m) => m.target);
const showNow = st.monitoring?.some((m) => m.current);
const STATUS_TAG = { pass: 'Pass', final: 'Final', provisional: 'Provisional', fail: 'Fail', pending: 'Not run yet' } as const;
const tailToc = [
  st.evals?.length && { slug: 'evals', text: 'Evals' },
  st.improvements?.length && { slug: 'improvements', text: 'How it improved' },
  st.monitoring?.length && { slug: 'monitoring', text: 'Metrics and monitoring' },
  st.learnings?.length && { slug: 'learnings', text: 'What I learned' },
  st.next?.length && { slug: 'next', text: "What's next" },
  { slug: 'feedback', text: 'Feedback' },
].filter(Boolean) as { slug: string; text: string }[];
const bodyToc = headings.filter((h) => h.depth === 2 && h.slug !== 'how-it-works').map((h) => ({ slug: h.slug, text: h.text }));
const toc = [...storyToc, ...bodyToc, ...tailToc];
const all = await projects();
const i = all.findIndex((p) => p.id === project.id);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const facts = [
  ['Role', d.role ?? 'Product and build'],
  ['Year', d.year],
  ['Type', KIND_LABEL[d.kind]],
  ['Stack', d.stack.slice(0, 3).join(', ') || '—'],
];
---
<Base title={d.title} description={`${d.tagline}${d.headline ? ` ${d.headline.value} ${d.headline.label}.` : ''}`} image={d.cover}>
  <article class="wrap page">
    <nav class="crumb label" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/projects/">Builds</a> / <span>{d.title}</span></nav>
    <header>
      <span class:list={['status', d.status]}>{STATUS_LABEL[d.status]}</span>
      <h1 class="cond">{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
    </header>

    <dl class="facts">
      {facts.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
    </dl>

    {d.headline ? (
      <section class="result" aria-label="Headline result">
        <div class="hero-metric">
          <span class="num big"><span class="hl">{d.headline.value}</span></span>
          <p class="hl-label">{d.headline.label}</p>
          {d.headline.note && <p class="note">{d.headline.note}</p>}
        </div>
        {d.metrics.length > 0 && (
          <dl class="metrics">{d.metrics.map((m) => <div><dt class="num">{m.value}</dt><dd class="label">{m.label}</dd></div>)}</dl>
        )}
      </section>
    ) : (
      <section class="result pending" aria-label="Status">
        <p>The headline result, result charts and cost per run appear here when the evaluation run is published.</p>
      </section>
    )}

    {links.length > 0 && (
      <nav class="links" aria-label="Project links">
        {links.map(([k, v], n) => <a class:list={['btn', { primary: n === 0 }]} href={v} rel="noopener">{LINK_LABEL[k] ?? k} ↗</a>)}
      </nav>
    )}

    {(st.overview || st.impact?.length) && (
      <section class="ovim" aria-label="Overview and impact">
        {st.overview && <div><p class="label">Overview</p><p class="ov">{st.overview}</p></div>}
        {st.impact?.length && <div><p class="label">Impact</p><ul class="im">{st.impact.map((x) => <li>{x}</li>)}</ul></div>}
      </section>
    )}

    {d.cover && <figure class="cover"><img src={d.cover} alt={`${d.title} product screen`} width="1440" height="900" /></figure>}

    {results.map((im) => (
      <figure class="panel"><img src={im.src} alt={im.alt} loading="lazy" />{im.caption && <figcaption class="label">{im.caption}</figcaption>}</figure>
    ))}

    <div class="body">
      <div class="prose">
        {st.pain && (
          <section class="story" aria-labelledby="pain">
            <h2 id="pain">The pain</h2>
            <p class="who"><span class="label">Who hurts</span>{st.pain.who}</p>
            <p>{st.pain.problem}</p>
            {st.pain.evidence?.map((e) => (
              <blockquote>
                <p>{e.text}</p>
                {(e.source || e.url) && <cite class="label">{e.url ? <a href={e.url} rel="noopener">{e.source ?? 'Source'} ↗</a> : e.source}</cite>}
              </blockquote>
            ))}
          </section>
        )}

        {(st.bet || st.priorities?.length) && (
          <section class="story" aria-labelledby="priorities">
            <h2 id="priorities">The bet and the cuts</h2>
            {st.bet && <p class="bet"><span class="label">The bet</span>{st.bet}</p>}
            {st.priorities?.length && (
              <table class="calls">
                <thead><tr><th>Call</th><th>What</th><th>Why</th></tr></thead>
                <tbody>{st.priorities.map((pr) => <tr><td><span class:list={['call', pr.call]}>{CALL_LABEL[pr.call]}</span></td><td>{pr.item}</td><td>{pr.why}</td></tr>)}</tbody>
              </table>
            )}
          </section>
        )}

        {(diagrams.length > 0 || designLinks.length > 0) && (
          <section class="story" aria-labelledby="how-it-works">
            <h2 id="how-it-works">How it works</h2>
            {diagrams.map((im) => (
              <figure class="panel"><img src={im.src} alt={im.alt} loading="lazy" /><figcaption class="label">{im.kind === 'dataflow' ? 'Data flow' : 'Architecture'}{im.caption && ` · ${im.caption}`}</figcaption></figure>
            ))}
            {designLinks.length > 0 && (
              <p class="doc-links">{designLinks.map((k) => <a href={d.links[k]} rel="noopener">Full {LINK_LABEL[k].toLowerCase()} doc ↗</a>)}</p>
            )}
          </section>
        )}

        <Content />
        {shots.map((im) => <figure class="panel"><img src={im.src} alt={im.alt} loading="lazy" />{im.caption && <figcaption class="label">{im.caption}</figcaption>}</figure>)}

        {st.evals?.length && (
          <section class="story" aria-labelledby="evals">
            <h2 id="evals">Evals</h2>
            <p class="lead">Every test the build was put through, with the data it ran on and the result, including what is still provisional.</p>
            <table class="evals">
              <thead><tr><th>Eval</th><th>Data</th><th>Method</th><th>Result</th></tr></thead>
              <tbody>{st.evals.map((e) => (
                <tr>
                  <td><strong>{e.url ? <a href={e.url} rel="noopener">{e.name} ↗</a> : e.name}</strong></td>
                  <td>{e.data}</td>
                  <td>{e.method}</td>
                  <td><span class:list={['est', e.status]}>{STATUS_TAG[e.status]}</span>{e.result}</td>
                </tr>
              ))}</tbody>
            </table>
          </section>
        )}

        {st.improvements?.length && (
          <section class="story" aria-labelledby="improvements">
            <h2 id="improvements">How it improved</h2>
            <div class="imp">{st.improvements.map((i) => (
              <div class="imp-card">
                <p class="label">{i.metric}</p>
                <p class="ba"><span class="b">{i.before}</span><span class="arr" aria-label="became">→</span><span class="a"><span class="hl">{i.after}</span></span></p>
                <p class="chg">{i.change}{i.url && <> <a href={i.url} rel="noopener">Record ↗</a></>}</p>
              </div>
            ))}</div>
          </section>
        )}

        {st.monitoring?.length && (
          <section class="story" aria-labelledby="monitoring">
            <h2 id="monitoring">Metrics and monitoring</h2>
            <table class="monitor">
              <thead><tr><th>Metric</th>{showTarget && <th>Target</th>}{showNow && <th>Now</th>}<th>How it is watched</th></tr></thead>
              <tbody>{st.monitoring.map((m) => (
                <tr>
                  <td><span class:list={['kind', m.kind]}>{KIND_TAG[m.kind]}</span><strong>{m.metric}</strong></td>
                  {showTarget && <td>{m.target ?? '—'}</td>}
                  {showNow && <td class="num-cell">{m.current ?? '—'}</td>}
                  <td>{m.how}</td>
                </tr>
              ))}</tbody>
            </table>
          </section>
        )}

        {st.learnings?.length && (
          <section class="story" aria-labelledby="learnings">
            <h2 id="learnings">What I learned</h2>
            <ol class="learn">{st.learnings.slice(0, 3).map((l) => (
              <li><p class="ls">{l.lesson}</p><p class="now"><span class="label">What I do now</span>{l.now}{l.url && <> <a href={l.url} rel="noopener">Source ↗</a></>}</p></li>
            ))}</ol>
            {st.learnings.length > 3 && (
              <details class="more-l"><summary>{st.learnings.length - 3} more lesson{st.learnings.length - 3 > 1 ? 's' : ''}</summary>
                <ol class="learn" start="4">{st.learnings.slice(3).map((l) => (
                  <li><p class="ls">{l.lesson}</p><p class="now"><span class="label">What I do now</span>{l.now}{l.url && <> <a href={l.url} rel="noopener">Source ↗</a></>}</p></li>
                ))}</ol>
              </details>
            )}
          </section>
        )}

        {st.next?.length && (
          <section class="story" aria-labelledby="next">
            <h2 id="next">What's next</h2>
            <ol>{st.next.map((n) => <li>{n}</li>)}</ol>
          </section>
        )}

        <section class="fb" id="feedback" aria-label="Feedback">
          <p class="label">Feedback</p>
          <p class="fb-h cond">Spot a gap? Tell me.</p>
          <p>A shaky number, a better approach, or a bug in the demo. It goes straight to my inbox.</p>
          <div class="fb-actions">
            <button type="button" class="btn primary" data-feedback data-subject={`Feedback on ${d.title}`}>Send feedback ✉</button>
            {d.links.repo && <a class="btn" href={`${d.links.repo}/issues/new`} rel="noopener">Open an issue ↗</a>}
          </div>
        </section>
      </div>
      <aside class="rail">
        {toc.length > 3 && (
          <nav class="block" aria-label="On this page"><p class="label">On this page</p>{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
        )}
        {d.proof.length > 0 && (
          <div class="block"><p class="label">Proof</p>{d.proof.map((p) => <a class="proof" href={p.url} rel="noopener">{p.label} ↗</a>)}</div>
        )}
        {d.stack.length > 0 && (<div class="block"><p class="label">Tech stack</p><div class="stack">{d.stack.map((s) => <span>{s}</span>)}</div></div>)}
        {d.methodology.length > 0 && (
          <details class="block" open><summary class="label">Methodology</summary><ol class="method">{d.methodology.map((m) => <li>{m}</li>)}</ol></details>
        )}
        {d.cost && (<div class="block"><p class="label">Cost</p><p>{d.cost}</p></div>)}
      </aside>
    </div>

    <nav class="pager" aria-label="More builds">
      <a href={`/projects/${prev.id}/`}><span class="label">← Previous</span><span class="pt">{prev.data.title}</span></a>
      <a href={`/projects/${next.id}/`} class="nx"><span class="label">Next →</span><span class="pt">{next.data.title}</span></a>
    </nav>
  </article>
</Base>

<style>
  .page { padding-block: 28px 0; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--ink); }
  header { margin-top: 32px; }
  h1 { font-size: clamp(56px, 10vw, 128px); margin: 14px 0 0; }
  .tagline { font-size: clamp(18px, 2vw, 22px); color: var(--muted); max-width: 58ch; margin: 18px 0 0; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 36px 0 0; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .facts div { padding: 14px 16px; border-right: 1px solid var(--line); min-width: 0; }
  .facts div:last-child { border-right: 0; }
  .facts dd { margin: 4px 0 0; font-weight: 500; font-size: 15px; }
  @media (max-width: 720px) { .facts { grid-template-columns: 1fr 1fr; } .facts div:nth-child(-n+2) { border-bottom: 1px solid var(--line); } .facts div:nth-child(2) { border-right: 0; } }
  .result { margin-top: 28px; padding: clamp(20px, 3vw, 32px); border-top: 3px solid var(--ink); background: var(--surface); border-radius: 0 0 var(--r) var(--r); }
  .big { font-size: clamp(72px, 12vw, 148px); }
  .hl-label { font-size: clamp(17px, 1.8vw, 20px); font-weight: 500; margin: 14px 0 0; max-width: 56ch; }
  .note { margin: 10px 0 0; color: var(--muted); font-size: 14.5px; max-width: 78ch; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0; margin: 28px 0 0; border-top: 1px solid var(--line); }
  .metrics div { padding: 16px 16px 0 0; }
  .metrics dt { font-size: clamp(32px, 4vw, 44px); }
  .metrics dd { margin: 6px 0 0; text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  .result.pending { border-top-color: var(--accent); }
  .result.pending p { margin: 0; color: var(--ink-2); max-width: 70ch; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .cover, .panel { margin: 32px 0 0; }
  .cover img { border-radius: var(--r); border: 1px solid var(--line); }
  .panel { background: var(--surface); border-radius: var(--r); padding: clamp(12px, 2vw, 24px); }
  .panel img { border-radius: 8px; background: #fff; }
  .panel figcaption { margin-top: 10px; text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: clamp(32px, 5vw, 64px); margin-top: clamp(40px, 6vw, 64px); }
  .rail { position: sticky; top: 86px; align-self: start; display: flex; flex-direction: column; gap: 22px; font-size: 14px; }
  .rail .block { display: flex; flex-direction: column; gap: 8px; padding-top: 12px; border-top: 1px solid var(--line); }
  .rail .label { margin: 0; }
  .rail nav a { color: var(--muted); text-decoration: none; }
  .rail nav a:hover { color: var(--ink); }
  .proof { font-weight: 500; text-decoration: none; }
  .proof:hover { color: var(--accent); }
  summary { cursor: pointer; }
  .method { margin: 8px 0 0; padding-left: 18px; color: var(--ink-2); display: grid; gap: 6px; }
  .rail p { margin: 0; }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } .rail { position: static; order: -1; } .rail nav.block { display: none; } }
  .prose { max-width: 70ch; font-size: 17px; min-width: 0; }
  .prose :global(h2) { font: 800 clamp(30px, 3.6vw, 40px)/1 var(--f-display); font-stretch: 72%; text-transform: uppercase; margin: 48px 0 14px; scroll-margin-top: 84px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 18px; margin: 28px 0 8px; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; margin: 18px 0; display: block; overflow-x: auto; }
  .prose :global(th) { font: 500 11.5px var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); text-align: left; padding: 8px 10px; border-bottom: 2px solid var(--ink); }
  .prose :global(td) { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(code) { font: 13.5px var(--f-mono); background: var(--surface); padding: 2px 5px; border-radius: 4px; }
  .prose :global(pre) { overflow-x: auto; padding: 16px; border-radius: 10px; font-size: 13.5px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(blockquote) { margin: 20px 0; padding: 4px 0 4px 18px; border-left: 4px solid var(--lime); }
  .prose :global(img) { border-radius: 10px; border: 1px solid var(--line); }
  .who, .bet { display: flex; flex-direction: column; gap: 6px; font-size: 19px; color: var(--ink) !important; font-weight: 500; margin: 0 0 14px; }
  .bet { border-left: 4px solid var(--lime); padding-left: 16px; }
  .prose blockquote cite { display: block; margin-top: 6px; font-style: normal; text-transform: none; letter-spacing: 0; }
  .prose blockquote p { margin: 0; color: var(--ink); }
  .call, .kind { display: inline-block; font: 500 11px/1 var(--f-mono); text-transform: uppercase; letter-spacing: .05em; padding: 4px 6px; border-radius: 4px; border: 1px solid var(--line); white-space: nowrap; }
  .call.built { background: var(--lime); color: var(--on-lime); border-color: transparent; }
  .call.cut { text-decoration: line-through; color: var(--muted); }
  .kind { display: table; margin-bottom: 6px; color: var(--muted); }
  .kind.north-star { background: var(--ink); color: var(--bg); border-color: transparent; }
  .num-cell { font-family: var(--f-mono); white-space: nowrap; }
  .lead { margin-top: -4px; }
  .ovim { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); margin-top: 28px; padding: clamp(18px, 3vw, 28px) 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ovim .label { margin: 0 0 8px; }
  .ov { margin: 0; font-size: clamp(17px, 1.7vw, 19px); line-height: 1.55; color: var(--ink); }
  .im { margin: 0; padding-left: 18px; display: grid; gap: 8px; font-size: 15.5px; color: var(--ink-2); }
  .im li::marker { color: var(--accent); }
  @media (max-width: 760px) { .ovim { grid-template-columns: 1fr; } }
  .more-l summary { cursor: pointer; font-weight: 500; color: var(--accent); margin: 4px 0 8px; }
  .learn[start="4"] { counter-reset: l 3; }
  .evals td:first-child { min-width: 130px; }
  .evals td:last-child { min-width: 170px; color: var(--ink); }
  .est { display: table; margin-bottom: 6px; font: 500 11px/1 var(--f-mono); text-transform: uppercase; letter-spacing: .05em; padding: 4px 6px; border-radius: 4px; border: 1px solid var(--line); color: var(--muted); }
  .est.pass { background: var(--lime); color: var(--on-lime); border-color: transparent; }
  .est.provisional { color: var(--accent); border-color: currentColor; }
  .est.fail { color: #c2410c; border-color: currentColor; }
  .imp { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin: 18px 0; }
  .imp-card { border: 1px solid var(--line); border-top: 3px solid var(--ink); border-radius: 0 0 var(--r) var(--r); padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .imp-card .label { margin: 0; text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  .ba { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; font: 800 clamp(26px, 3vw, 34px)/1 var(--f-display); font-stretch: 72%; color: var(--ink) !important; }
  .ba .b { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 2px; }
  .ba .arr { font-size: .7em; color: var(--muted); }
  .chg { margin: 0; font-size: 14.5px; }
  .learn { list-style: none; padding: 0; margin: 18px 0; display: grid; gap: 12px; counter-reset: l; }
  .learn li { counter-increment: l; position: relative; padding: 14px 16px 14px 52px; background: var(--surface); border-radius: var(--r); }
  .learn li::before { content: counter(l, decimal-leading-zero); position: absolute; left: 16px; top: 14px; font: 500 13px/1.6 var(--f-mono); color: var(--muted); }
  .ls { margin: 0; color: var(--ink) !important; font-weight: 500; }
  .now { margin: 8px 0 0; font-size: 15px; display: flex; flex-direction: column; gap: 4px; }
  .now .label { text-transform: uppercase; }
  .doc-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .fb { margin-top: 56px; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 0 0 var(--r) var(--r); }
  .fb .label { margin: 0; }
  .fb-h { font-size: clamp(28px, 3.4vw, 38px); margin: 10px 0 8px; color: var(--ink) !important; }
  .fb-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .fb .btn { text-decoration: none; color: var(--ink); }
  .fb .btn.primary { color: var(--bg); }
  .fb .btn.primary:hover { color: #fff; }
  .fb button.btn { cursor: pointer; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: clamp(56px, 8vw, 96px); border-top: 3px solid var(--ink); padding-top: 18px; }
  .pager a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .pager .nx { text-align: right; align-items: flex-end; }
  .pt { font: 800 clamp(24px, 3vw, 36px)/1 var(--f-display); font-stretch: 72%; text-transform: uppercase; }
