---
import '../styles/global.css';
import { site } from '../site.config';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = `${site.name}: ${site.roles.join(', ')}. ${site.proof[0]}`, image } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.roles.join(' · ')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <span class="cond">{site.name}</span><span class="bib" aria-label="India">IND</span>
      </a>
      <nav aria-label="Main">
        <a class="nl" href="/#work">Work</a>
        <a class="nl" href="/projects/" aria-current={path.startsWith('/projects') ? 'page' : undefined}>Builds</a>
        <a class="nl" href="/#sport">Sport</a>
        <a class="nx" href={site.links.cv} rel="noopener"><Icon name="download" /><span>CV</span></a>
        <a class="nx" href={site.links.linkedin} rel="me noopener" aria-label="LinkedIn"><Icon name="linkedin" /><span class="nxt">LinkedIn</span></a>
        <a class="nx" href={site.links.github} rel="me noopener" aria-label="GitHub"><Icon name="github" /><span class="nxt">GitHub</span></a>
        <button class="theme" type="button" aria-label="Switch light or dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <p class="cond foot-name">{site.name}</p>
        <div class="foot-links">
          <a href={site.links.cv} rel="noopener"><Icon name="download" />Download CV</a>
          <a href={site.links.linkedin} rel="me noopener"><Icon name="linkedin" />LinkedIn</a>
          <a href={site.links.github} rel="me noopener"><Icon name="github" />GitHub</a>
          <button type="button" class="linkish" data-feedback data-subject="Feedback on the portfolio">Send feedback</button>
          {site.links.email && <a href={`mailto:${site.links.email}`}>Email</a>}
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
      <p class="label foot-note">{site.location} · Built with Astro · New builds are published from the command line</p>
    </div>
  </footer>
  <dialog class="fbd" aria-labelledby="fbd-h">
    <form class="fbd-form" novalidate>
      <div class="fbd-top">
        <p class="label" id="fbd-about"></p>
        <button type="button" class="fbd-x" data-close aria-label="Close">×</button>
      </div>
      <h2 class="cond" id="fbd-h">Send feedback</h2>
      <p class="fbd-sub">A shaky number, a better idea, a bug. It goes straight to my inbox.</p>
      <label>What did you notice?<textarea name="message" rows="5" required maxlength="4000"></textarea></label>
      <div class="fbd-row">
        <label><span>Name <span class="opt">(optional)</span></span><input name="name" autocomplete="name" maxlength="120" /></label>
        <label><span>Email for a reply <span class="opt">(optional)</span></span><input name="email" type="email" autocomplete="email" maxlength="200" /></label>
      </div>
      <input class="hp" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="fbd-msg" role="status" aria-live="polite"></p>
      <div class="fbd-actions">
        <button type="submit" class="btn primary">Send</button>
        <button type="button" class="btn" data-close>Cancel</button>
      </div>
    </form>
  </dialog>
  <script is:inline define:vars={{ fb: site.feedback }}>
    (() => {
      const dlg = document.querySelector('.fbd');
      const form = dlg.querySelector('form');
      const msg = dlg.querySelector('.fbd-msg');
      const send = form.querySelector('[type=submit]');
      let subject = 'Portfolio feedback';
      const mailto = (s, body) => `mailto:${fb.user}@${fb.domain}?${new URLSearchParams({ subject: s, body }).toString().replace(/\+/g, '%20')}`;
      document.addEventListener('click', (e) => {
        const b = e.target.closest('[data-feedback]');
        if (!b) return;
        subject = b.dataset.subject || 'Portfolio feedback';
        if (!fb.formspree || typeof dlg.showModal !== 'function') { location.href = mailto(subject, `Page: ${location.href}\n\nWhat I noticed:\n`); return; }
        dlg.querySelector('#fbd-about').textContent = subject.replace(/^Feedback on /, '');
        dlg.querySelector('#fbd-h').textContent = b.dataset.title || 'Send feedback';
        msg.textContent = ''; msg.className = 'fbd-msg'; send.disabled = false;
        dlg.showModal();
        form.message.focus();
      });
      form.addEventListener('input', () => { if (msg.classList.contains('err')) { msg.textContent = ''; msg.className = 'fbd-msg'; } });
      dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.closest('[data-close]')) dlg.close(); });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.message.value.trim()) { msg.textContent = 'Write a line or two first.'; msg.className = 'fbd-msg err'; form.message.focus(); return; }
        if (form.email.value && !form.email.checkValidity()) { msg.textContent = 'That email address looks off.'; msg.className = 'fbd-msg err'; form.email.focus(); return; }
        send.disabled = true; msg.textContent = 'Sending…'; msg.className = 'fbd-msg';
        const data = { _subject: subject, page: location.href, message: form.message.value.trim(), name: form.name.value.trim(), email: form.email.value.trim(), _gotcha: form._gotcha.value };
        try {
          const r = await fetch(`https://formspree.io/f/${fb.formspree}`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
          if (!r.ok) throw new Error(String(r.status));
          form.reset(); msg.textContent = 'Sent. Thank you, I read every one.'; msg.className = 'fbd-msg ok';
          setTimeout(() => dlg.open && dlg.close(), 2200);
        } catch {
          send.disabled = false;
          msg.innerHTML = '';
          msg.className = 'fbd-msg err';
          const a = document.createElement('a');
          a.href = mailto(subject, `${data.message}\n\nPage: ${data.page}`);
          a.textContent = 'send it by email instead';
          msg.append("Couldn't send just now. Try again, or ", a, '.');
        }
      });
    })();
  </script>
  <script is:inline>
    document.querySelector('.theme')?.addEventListener('click', () => {
      const r = document.documentElement;
      const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      r.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 20; background: var(--bg); padding: 8px 12px; border-radius: 8px; }
  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 62px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
  .brand .cond { font-size: 19px; line-height: 1; }
  .bib { font: 500 10.5px/1 var(--f-mono); background: var(--lime); color: var(--on-lime); padding: 4px 6px; border-radius: 4px; letter-spacing: .04em; }
  nav { display: flex; align-items: center; gap: 20px; font-size: 14px; }
  nav a { text-decoration: none; white-space: nowrap; }
  .nl { color: var(--muted); }
  .nl:hover, .nl[aria-current='page'] { color: var(--ink); }
  .nx { font-weight: 500; display: inline-flex; align-items: center; gap: 6px; }
  .nx:hover { color: var(--accent); }
  .theme { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); cursor: pointer; }
  .theme svg { width: 16px; height: 16px; }
  @media (max-width: 420px) { .brand .bib { display: none; } nav { gap: 12px !important; } }
  @media (max-width: 720px) { .nl { font-size: 14px; } .nxt { display: none; } .nx { font-size: 18px; } .brand .cond { font-size: 16px; } nav { gap: 16px; } }
  .foot { margin-top: clamp(64px, 10vw, 120px); border-top: 3px solid var(--ink); padding-block: 28px 56px; }
  .foot-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .foot-name { font-size: clamp(36px, 6vw, 64px); margin: 0; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14.5px; font-weight: 500; }
  .foot-links a { text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .foot-links a:hover { color: var(--accent); }
  .foot-note { margin: 20px 0 0; }
  .linkish { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
  .linkish:hover { color: var(--accent); }
  .linkish:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .fbd { width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 0; border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 0 0 var(--r) var(--r); background: var(--bg); color: var(--ink); }
  .fbd::backdrop { background: rgb(13 17 23 / .55); backdrop-filter: blur(2px); }
  .fbd-form { display: flex; flex-direction: column; gap: 14px; padding: clamp(18px, 4vw, 28px); }
  .fbd-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .fbd-top .label { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fbd-x { border: 0; background: none; color: var(--muted); font-size: 26px; line-height: 1; cursor: pointer; padding: 0 4px; }
  .fbd-x:hover { color: var(--ink); }
  .fbd h2 { font-size: clamp(30px, 5vw, 40px); margin: 0; }
  .fbd-sub { margin: -4px 0 0; color: var(--muted); font-size: 15px; }
  .fbd label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; min-width: 0; }
  .fbd .opt { color: var(--muted); font-weight: 400; }
  .fbd input, .fbd textarea { font: 15px/1.45 var(--f-body); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; width: 100%; box-sizing: border-box; }
  .fbd textarea { resize: vertical; min-height: 110px; }
  .fbd input:focus, .fbd textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  .fbd-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 520px) { .fbd-row { grid-template-columns: 1fr; } }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .fbd-msg { margin: 0; min-height: 1.2em; font-size: 14px; color: var(--muted); }
  .fbd-msg.ok { color: var(--good, #15803d); font-weight: 500; }
  .fbd-msg.err { color: #c2410c; }
  .fbd-msg a { color: var(--accent); }
  .fbd-actions { display: flex; gap: 10px; }
  .fbd-actions .btn { cursor: pointer; }
  .fbd-actions .btn:disabled { opacity: .55; cursor: progress; }
</style>
